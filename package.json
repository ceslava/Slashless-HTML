{
  "name": "slashless-html",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "ceslava",
  "author": {
    "name": "Cristian Eslava",
    "url": "https://ceslava.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/ceslava/Slashless-HTML#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceslava/Slashless-HTML.git"
  },
  "bugs": {
    "url": "https://github.com/ceslava/Slashless-HTML/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "html",
    "html5",
    "formatter",
    "void elements",
    "self-closing",
    "trailing slash",
    "slash",
    "prettier"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./src/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "slashlessHtml.setAsDefaultFormatter",
        "title": "%command.setAsDefaultFormatter%",
        "category": "Slashless HTML"
      },
      {
        "command": "slashlessHtml.formatDocument",
        "title": "%command.formatDocument%",
        "category": "Slashless HTML"
      }
    ]
  },
  "scripts": {
    "test": "node test/run.js",
    "package": "npx --yes @vscode/vsce package",
    "vendor-prettier": "node scripts/vendor-prettier.js"
  },
  "prettierVersion": "3.8.1"
}
